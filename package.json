{
    "name": "CosmoStudio",
    "productName": "CosmoStudio",
    "version": "1.0.0",
    "description": "My Electron application description",
    "main": ".vite/build/main.js",
    "workspaces": [
        "packages/*",
        "src/renderer"
    ],
    "scripts": {
        "postinstall": "node scripts/patch-electron-forge-plugin-vite.mjs",
        "generate-api": "ts-node -r tsconfig-paths/register scripts/generate-api.ts && npm run prettier",
        "download-provider-logos": "ts-node scripts/download-provider-logos.ts",
        "next:dev": "cd src/renderer && npm run dev",
        "dev": "npm run dev:electron",
        "dev:electron": "concurrently -k \"cd src/renderer && cross-env NEXT_PUBLIC_COSMO_BACKEND=electron npm run dev\" \"npm run start\"",
        "dev:http": "concurrently -k \"cross-env NODE_ENV=development COSMO_RUNTIME_TARGET=http npm run start:http:dev\" \"cd src/renderer && cross-env NEXT_PUBLIC_COSMO_BACKEND=http NEXT_PUBLIC_COSMO_API_BASE=http://127.0.0.1:4000/api npm run dev\"",
        "start": "npm i && cross-env NODE_ENV=development COSMO_RUNTIME_TARGET=electron electron-forge start",
        "start:http:dev": "ts-node -r tsconfig-paths/register src/main/http/index.ts",
        "build:renderer:electron": "cd src/renderer && cross-env NEXT_PUBLIC_COSMO_BACKEND=electron npm run build",
        "build:renderer:http": "cd src/renderer && cross-env NEXT_PUBLIC_COSMO_BACKEND=http NEXT_PUBLIC_COSMO_API_BASE=/api npm run build",
        "build:http": "npm run generate-api && npm run build:renderer:http && cross-env NODE_ENV=production COSMO_RUNTIME_TARGET=http vite build --config vite.http.config.mts",
        "start:http": "node .vite/http/main.js",
        "package": "npm run build:renderer:electron && cross-env NODE_ENV=production COSMO_RUNTIME_TARGET=electron electron-forge package",
        "make": "npm run build:renderer:electron && cross-env NODE_ENV=production COSMO_RUNTIME_TARGET=electron electron-forge make",
        "publish": "npm run build:renderer:electron && cross-env NODE_ENV=production COSMO_RUNTIME_TARGET=electron electron-forge publish",
        "lint": "gts lint",
        "fix": "gts fix",
        "prettier": "npx eslint . --fix && prettier . --write",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "db:push": "drizzle-kit push",
        "db:pull": "drizzle-kit pull",
        "db:check": "drizzle-kit check",
        "db:up": "drizzle-kit up",
        "test": "vitest run --config vitest.config.mts",
        "test:coverage": "vitest run --coverage --config vitest.config.mts",
        "test:watch": "vitest --config vitest.config.mts"
    },
    "keywords": [],
    "author": {
        "name": "Cosmo-cp",
        "email": "gaurav@cosmocp.com"
    },
    "license": "AGPL",
    "private": true,
    "devDependencies": {
        "@ai-sdk/deepseek": "^3.0.54",
        "@ai-sdk/groq": "^4.0.50",
        "@ai-sdk/mistral": "^4.0.52",
        "@ai-sdk/xai": "^5.0.10",
        "@electron-forge/cli": "^7.11.2",
        "@electron-forge/maker-deb": "^7.11.2",
        "@electron-forge/maker-rpm": "^7.11.2",
        "@electron-forge/maker-squirrel": "^7.11.2",
        "@electron-forge/maker-zip": "^7.11.2",
        "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
        "@electron-forge/plugin-fuses": "^7.11.2",
        "@electron-forge/plugin-vite": "^7.11.2",
        "@electron-forge/publisher-github": "^7.11.2",
        "@electron/fuses": "^1.8.0",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@types/node": "^26.6.3",
        "@typescript-eslint/eslint-plugin": "^8.70.1",
        "@typescript-eslint/parser": "^8.70.1",
        "@vitest/coverage-v8": "^5.0.2",
        "concurrently": "^10.0.5",
        "cross-env": "^10.1.0",
        "drizzle-kit": "^0.31.11",
        "electron": "^44.4.5",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "gts": "^7.0.0",
        "jsdom": "^30.1.1",
        "prettier": "^3.9.9",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.1",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^5.0.2"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^4.0.65",
        "@ai-sdk/cohere": "^4.0.50",
        "@ai-sdk/google": "^4.0.82",
        "@ai-sdk/huggingface": "^2.0.57",
        "@ai-sdk/mcp": "^2.0.60",
        "@ai-sdk/moonshotai": "^3.0.58",
        "@ai-sdk/openai": "^4.0.78",
        "@ai-sdk/openai-compatible": "^3.0.57",
        "@ai-sdk/perplexity": "^5.0.0",
        "@ai-sdk/provider": "^4.0.18",
        "@electric-sql/pglite": "^0.5.8",
        "@mcpc-tech/acp-ai-provider": "^0.3.8",
        "@nestjs/common": "^12.1.0",
        "@nestjs/core": "^12.1.0",
        "@nestjs/platform-express": "^12.1.0",
        "@nestjs/serve-static": "^12.0.0",
        "@stepperize/react": "^8.0.0",
        "@types/express": "^5.0.6",
        "ai": "^7.0.116",
        "ai-sdk-ollama": "^4.3.0",
        "dotenv": "^18.0.4",
        "drizzle-orm": "^0.45.3",
        "drizzle-zod": "0.8.3",
        "electron-log": "5.4.4",
        "electron-squirrel-startup": "1.0.1",
        "inversify": "7.11.0",
        "reflect-metadata": "0.2.2",
        "rxjs": "^7.8.2",
        "superjson": "^2.2.6",
        "update-electron-app": "^3.3.0",
        "workflow": "^4.8.9",
        "zod": "^4.6.5"
    }
}
