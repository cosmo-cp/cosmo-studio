{
  "name": "CosmoStudio",
  "productName": "CosmoStudio",
  "version": "1.0.0",
  "description": "My Electron application description",
  "main": ".vite/build/main.js",
  "workspaces": [
    "packages/*",
    "src/renderer"
  ],
  "scripts": {
    "generate-api": "ts-node -r tsconfig-paths/register scripts/generate-api.ts",
    "download-provider-logos": "ts-node scripts/download-provider-logos.ts",
    "next:dev": "cd src/renderer && npm run dev",
    "dev": "npm run dev:electron",
    "dev:electron": "concurrently -k \"cd src/renderer && cross-env NEXT_PUBLIC_COSMO_BACKEND=electron npm run dev\" \"npm run start\"",
    "dev:http": "concurrently -k \"cross-env NODE_ENV=development COSMO_RUNTIME_TARGET=http npm run start:http:dev\" \"cd src/renderer && cross-env NEXT_PUBLIC_COSMO_BACKEND=http NEXT_PUBLIC_COSMO_API_BASE=http://127.0.0.1:4000/api npm run dev\"",
    "start": "npm i && cross-env NODE_ENV=development COSMO_RUNTIME_TARGET=electron electron-forge start",
    "start:http:dev": "ts-node -r tsconfig-paths/register src/main/http/index.ts",
    "build:renderer:electron": "cd src/renderer && cross-env NEXT_PUBLIC_COSMO_BACKEND=electron npm run build",
    "build:renderer:http": "cd src/renderer && cross-env NEXT_PUBLIC_COSMO_BACKEND=http NEXT_PUBLIC_COSMO_API_BASE=/api npm run build",
    "build:http": "npm run generate-api && npm run build:renderer:http && cross-env NODE_ENV=production COSMO_RUNTIME_TARGET=http vite build --config vite.http.config.ts",
    "start:http": "node .vite/http/main.js",
    "package": "npm run build:renderer:electron && cross-env NODE_ENV=production COSMO_RUNTIME_TARGET=electron electron-forge package",
    "make": "npm run build:renderer:electron && cross-env NODE_ENV=production COSMO_RUNTIME_TARGET=electron electron-forge make",
    "publish": "npm run build:renderer:electron && cross-env NODE_ENV=production COSMO_RUNTIME_TARGET=electron electron-forge publish",
    "lint": "gts lint",
    "fix": "gts fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:check": "drizzle-kit check",
    "db:up": "drizzle-kit up",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": {
    "name": "Cosmo-cp",
    "email": "gaurav@cosmocp.com"
  },
  "license": "AGPL",
  "private": true,
  "devDependencies": {
    "@ai-sdk/deepseek": "^2.0.35",
    "@ai-sdk/groq": "^3.0.39",
    "@ai-sdk/mistral": "^3.0.37",
    "@ai-sdk/xai": "^3.0.91",
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron-forge/publisher-github": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitest/coverage-v8": "^4.1.6",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^39.8.10",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "gts": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.78",
    "@ai-sdk/cohere": "^3.0.36",
    "@ai-sdk/google": "3.0.75",
    "@ai-sdk/huggingface": "^1.0.49",
    "@ai-sdk/mcp": "1.0.42",
    "@ai-sdk/moonshotai": "^2.0.22",
    "@ai-sdk/openai": "3.0.64",
    "@ai-sdk/openai-compatible": "^2.0.47",
    "@ai-sdk/perplexity": "^3.0.33",
    "@ai-sdk/provider": "^3.0.10",
    "@electric-sql/pglite": "0.3.15",
    "@exalabs/ai-sdk": "^2.0.1",
    "@mcpc-tech/acp-ai-provider": "^0.3.3",
    "@nestjs/common": "^11.1.21",
    "@nestjs/core": "^11.1.21",
    "@nestjs/platform-express": "^11.1.21",
    "@nestjs/serve-static": "^5.0.5",
    "@stepperize/react": "5.1.9",
    "@types/express": "^5.0.6",
    "ai": "6.0.185",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.8.3",
    "electron-log": "5.4.4",
    "electron-squirrel-startup": "1.0.1",
    "inversify": "7.11.0",
    "ollama-ai-provider-v2": "3.5.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "^7.8.2",
    "superjson": "^2.2.6",
    "update-electron-app": "^3.2.0",
    "workflow": "^4.2.4",
    "zod": "4.4.3"
  }
}
