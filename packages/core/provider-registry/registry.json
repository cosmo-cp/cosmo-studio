            "support": { "route": "direct", "level": "experimental" },
            "adapter": { "key": "openai-native", "apiVersion": 1, "compatibilityRange": "^1.0.0" },
            "fields": [
                {
                    "key": "apiKey",
                    "scope": "connection",
                    "type": "secret",
                    "label": "API key",
                    "group": "simple",
                    "required": true
